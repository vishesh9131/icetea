# =============================================================================
# Icetea AI - environment variables
# =============================================================================
# Copy this file to .env. Never commit .env.

# --- Provider switch ---
# Pick one. All three providers share the same wire format (OpenAI Chat
# Completions), so swapping is a one-line env change.
#   openai - hits api.openai.com
#   vllm   - hits a self-hosted VLLM endpoint (default: corerec tunnel)
#   claude - hits Anthropic via their OpenAI-compat shim
# The onboarding UI lets the operator flip this at runtime via
# POST /v1/runtime/llm-provider (no restart needed).
LLM_PROVIDER=openai

# --- App ---
APP_ENV=development              # development | production | test
REQUEST_TIMEOUT_S=30

# --- OpenAI ---
# Required when LLM_PROVIDER=openai. Use gpt-4o-mini in dev, gpt-4.1 in eval.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                # leave blank for the SDK default

# --- VLLM (OpenAI-compatible) ---
# Required when LLM_PROVIDER=vllm. The default points at our self-hosted
# VLLM behind a Cloudflare Tunnel. The model name should match whatever
# the served model identifies as in /v1/models.
VLLM_BASE_URL=https://vllm.corerec.online/v1
VLLM_MODEL=default
# Most self-hosted VLLM deployments don't validate the key, but the
# OpenAI SDK still wants something non-empty. "EMPTY" works.
VLLM_API_KEY=EMPTY

# --- Anthropic Claude (OpenAI-compatible endpoint) ---
# Required when LLM_PROVIDER=claude. Anthropic ships an OpenAI Chat
# Completions compatibility shim at the URL below; we point the same
# openai SDK at it and pass ANTHROPIC_API_KEY as the bearer token.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# Optional - only set what you actually use
# =============================================================================

# --- Persistence (your choice) ---
# Sessions are in-memory by default; set this only if you front the
# session store with a real DB.
DATABASE_URL=

# --- Pre-classifier vector DB ---
# Only if you implement the optional embedding-based pre-classifier.
PGVECTOR_DATABASE_URL=

# --- Cache backend ---
# Only if you implement the optional dedupe cache and choose Redis.
REDIS_URL=

# --- Sessions ---
SESSION_TTL_S=21600
# Chat thread + carryover persisted here when APP_ENV is not test (JSON per session).
# Leave empty or unset for RAM-only sessions.
SESSION_MEMORY_DIR=Logs/memory

# --- Market data cache ---
MARKET_DATA_CACHE_TTL_S=900
